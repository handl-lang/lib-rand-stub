--- Deterministic, pure-Handl backend for random values.
---
--- @details
--- Returns fixed, reproducible values so tests and benchmarks stay
--- deterministic. This is a no-effect backend; it does not call any
--- FFI library.


-- Internal list helpers

arr_len := (xs) ~> do {
  while { xs: xs, n: 0 } {
    [xs, n] ~> match xs {
      []: { out: n },
      [_, ...t]: { state: { xs: t, n: n + 1 } }
    }
  }
}

arr_rev := (xs) ~> do {
  while { xs: xs, acc: [] } {
    [xs, acc] ~> match xs {
      []: { out: acc },
      [h, ...t]: { state: { xs: t, acc: [h, ...acc] } }
    }
  }
}

arr_take := (xs, n) ~> do {
  while { xs: xs, n: n, acc: [] } {
    [xs, n, acc] ~> if n <= 0 {
      { out: arr_rev(acc) }
    } else {
      match xs {
        []: { out: arr_rev(acc) },
        [h, ...t]: { state: { xs: t, n: n - 1, acc: [h, ...acc] } }
      }
    }
  }
}

  -- Always returns 4.
  
export int := (_max) ~> 4

  -- Always returns 0.5.
  
export float := (_max) ~> 0.5

  -- Always returns `true`.
  
export bool := () ~> true

  -- Always returns the first element.
  
export pick := (xs) ~> xs[0]

  -- Always returns the first weighted element.
  
export weighted_pick := (_weights, items) ~> items[0]

  -- Cycles through `count` elements, wrapping around the input.
  
export choice := (xs, count) ~> do {
    while { n: count, acc: [] } {
      [n, acc] ~> if n <= 0 {
        { out: arr_rev(acc) }
      } else {
        { state: { n: n - 1, acc: [xs[math.mod(n - 1, arr_len(xs))], ...acc] } }
      }
    }
  }

  -- Always returns the first `count` elements.
  
export sample := (xs, count) ~> arr_take(xs, count)

  -- Always returns the reverse as a deterministic permutation.
  
export shuffle := (xs) ~> arr_rev(xs)

  -- Always returns `n` bytes of value `4`.
  
export bytes := (n) ~> do {
    while { n: n, acc: [] } {
      [n, acc] ~> if n <= 0 {
        { out: arr_rev(acc) }
      } else {
        { state: { n: n - 1, acc: [4, ...acc] } }
      }
    }
  }

  -- Always returns a string of `len` copies of `charset[0]`.
  
export string := (len, charset) ~> do {
    c := char.at(charset, 0)
    while { n: len, acc: "" } {
      [n, acc] ~> if n <= 0 {
        { out: acc }
      } else {
        { state: { n: n - 1, acc: acc + c } }
      }
    }
  }

  -- Always returns `mean`.
  
export gauss := (mean, _stddev) ~> mean

  -- Always returns `0.0`.
  
export exponential := (_lambda) ~> 0.0

  -- Always returns 0.
  
export poisson := (_lambda) ~> 0

  -- Always returns 0.
  
export binomial := (_n, _p) ~> 0

  -- Seeded variants (deterministic, identical to non-seeded for the stub)
  
export seeded_int := (seed, _max) ~> 4

export seeded_float := (seed, _max) ~> 0.5

export seeded_bool := (seed) ~> true

export seeded_pick := (seed, xs) ~> xs[0]

export seeded_choice := (seed, xs, count) ~> do {
    while { n: count, acc: [] } {
      [n, acc] ~> if n <= 0 {
        { out: arr_rev(acc) }
      } else {
        { state: { n: n - 1, acc: [xs[math.mod(n - 1, arr_len(xs))], ...acc] } }
      }
    }
  }

export seeded_sample := (seed, xs, count) ~> arr_take(xs, count)

export seeded_shuffle := (seed, xs) ~> arr_rev(xs)

export seeded_string := (seed, len, charset) ~> do {
    c := char.at(charset, 0)
    while { n: len, acc: "" } {
      [n, acc] ~> if n <= 0 {
        { out: acc }
      } else {
        { state: { n: n - 1, acc: acc + c } }
      }
    }
  }

export seeded_gauss := (seed, mean, _stddev) ~> mean
